  "structures": [
    {
      "id": "no-solo-sino",
      "name": "\"No solo X, sino también Y\"",
      "regex": "(?i)\\bno s[oó]lo\\b[^.!?\\n]{2,80}\\bsino\\b",
      "fix": "Di la mitad que de verdad importa y borra la otra."
    },
    {
      "id": "no-es-solo",
      "name": "\"No es solo X, es Y\"",
      "regex": "(?i)\\bno es s[oó]lo\\b[^.!?\\n]{2,60}[,.]\\s*es\\b",
      "fix": "Quédate con lo que quieres decir. La primera mitad sobra."
    },
    {
      "id": "pregunta-retorica",
      "name": "Pregunta retórica de una palabra",
      "regex": "(?m)^\\s*¿[A-Za-zÁÉÍÓÚÑáéíóúñ]+\\?\\s*$",
      "fix": "Una pregunta de una palabra en su propia línea es un tic. Afírmalo."
    },
    {
      "id": "resultado",
      "name": "\"¿El resultado?\" / \"¿La mejor parte?\"",
      "regex": "(?i)¿(?:el resultado|la mejor parte|lo mejor|el problema|y sabes qu[eé])\\?",
      "fix": "Cuenta el resultado directamente, sin presentártelo con una pregunta."
    },
    {
      "id": "spoiler",
      "name": "\"Spoiler:\"",
      "regex": "(?im)^\\s*spoiler\\s*:",
      "fix": "Si lo vas a contar, cuéntalo."
    },
    {
      "id": "regla-de-tres",
      "name": "Trío de elementos cortos",
      "regex": "(?i)\\b\\w+[^,.!?\\n]{1,22},\\s*\\w+[^,.!?\\n]{1,22},?\\s*(?:y|e)\\s+\\w+[^,.!?\\n]{1,22}[.!?]",
      "fix": "El trío suena a plantilla. Deja dos, o alarga uno hasta romper el ritmo."
    },
    {
      "id": "muro-hashtags",
      "name": "Muro de hashtags",
      "regex": "(?:#[\\wÁÉÍÓÚÑáéíóúñ]+\\s*){5,}",
      "fix": "Tres como mucho, y que digan algo."
    },
    {
      "id": "cebo-interaccion",
      "name": "Cebo de interacción",
      "regex": "(?i)(?:¿(?:qu[eé] opinas|est[aá]s de acuerdo|y t[uú])\\?|comenta (?:abajo|aqu[ií])|dale a me gusta|comp[aá]rtelo si)",
      "fix": "Pedir el comentario no lo consigue. Una afirmación discutible, sí."
    },
    {
      "id": "enumeracion-emoji",
      "name": "Lista con emoji de viñeta",
      "regex": "(?m)^\\s*(?:✅|🔹|👉|🚀|💡|⚡|🔥)\\s*\\S",
      "fix": "El emoji de viñeta grita plantilla. Usa un guion, o nada."
    },
    {
      "id": "anafora",
      "name": "Tres frases seguidas con el mismo arranque",
      "regex": "(?m)^(\\w+ \\w+)[^\\n]*\\n+\\1[^\\n]*\\n+\\1",
      "fix": "La repetición de arranque suena a generador. Rompe una."
    }
  ]
}
