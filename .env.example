# Copia esto a .env.local dentro de apps/web y rellénalo.

# La contraseña con la que entras en la web y en la app del móvil.
MESA_PASSWORD=pon-aqui-una-contrasena-larga

# Clave para firmar las sesiones. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MESA_SECRET=

# Opcionales: sin ellas los borradores se guardan en data/local.json.
# En Vercel, conecta Upstash desde el panel y aparecen solas.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
